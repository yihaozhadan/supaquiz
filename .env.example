# Server Configuration
PORT=3000

# Data Storage
DATA_DIR=./data

# Database
DATABASE_URL=./data/supaquiz.db

# Admin Credentials
# The admin username for the single admin account
ADMIN_USER=admin
# The admin password hash (base64 encoded to avoid shell variable expansion)
# Generate with `bun run scripts/generate-hash.ts` - it will output a base64 encoded hash
ADMIN_PASS_HASH=YOUR_BASE64_ENCODED_HASH_HERE

# Session Security
# Secret key for signing admin session cookies (JWT)
# Generate a strong random string for production
SESSION_SECRET="change-me-in-production"

# File Upload Limits
# Maximum file size in bytes (default: 52428800 = 50MB)
MAX_FILE_SIZE=52428800
