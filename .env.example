# Server Configuration
PORT=3000

# Data Storage
DATA_DIR=./data

# Admin Credentials
# The admin username for the single admin account
ADMIN_USER=admin
# The admin password hash (use Argon2id or bcrypt to hash your password before setting this)
# Example: Generate with `bun run scripts/generate-hash.ts` or similar tool
ADMIN_PASS_HASH="$argon2id$v=19$m=65536,t=3,p=4$..."

# Session Security
# Secret key for signing admin session cookies (JWT)
# Generate a strong random string for production
SESSION_SECRET="change-me-in-production"

# File Upload Limits
# Maximum file size in bytes (default: 52428800 = 50MB)
MAX_FILE_SIZE=52428800
